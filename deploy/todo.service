[Unit]
Description=To-Do task app (Flask + Gunicorn)
After=network.target

[Service]
Type=simple
User=awatkins
Group=awatkins
WorkingDirectory=/home/awatkins/Applications/to-do
Environment=FLASK_CONFIG=production
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStartPre=/usr/bin/install -d -m 700 /home/awatkins/Applications/to-do/instance
ExecStartPre=/home/awatkins/Applications/to-do/.venv/bin/flask --app wsgi db upgrade
ExecStart=/home/awatkins/Applications/to-do/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/awatkins/Applications/to-do/instance

[Install]
WantedBy=multi-user.target
