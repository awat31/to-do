# Copy to .env (or set these in the systemd unit) to override defaults.
FLASK_CONFIG=production
#BIND=0.0.0.0:8000
#WEB_CONCURRENCY=2
#THREADS=2
# TODO_ADMIN_PASSWORD=change-me   # admin password; random one generated if unset
# TODO_SECURE_COOKIES=1           # enable ONLY behind an HTTPS reverse proxy
# TODO_DATABASE=sqlite:////root/to-do/instance/todo.sqlite3
# SECRET_KEY=            # random secret generated & stored in instance/ if unset
