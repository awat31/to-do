# Copy to .env (or set these in the systemd unit) to override defaults.
# Select the application configuration: production, development, or testing.
FLASK_CONFIG=production

# Address and port for Gunicorn to listen on.
# BIND=0.0.0.0:8000
# Number of Gunicorn worker processes; defaults to a value based on CPU count.
# WEB_CONCURRENCY=2
# Number of request-handling threads per Gunicorn worker.
# THREADS=2
# Seconds before Gunicorn times out a worker.
# GUNICORN_TIMEOUT=60
# Comma-separated addresses allowed to set proxy headers (loopback by default).
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Password for the initial admin account; a random password is generated if unset.
# TODO_ADMIN_PASSWORD=change-me

# Per-IP throttles (per gunicorn worker): login attempts per window and signups.
# TODO_LOGIN_IP_LIMIT=20
# TODO_LOGIN_IP_WINDOW_MINUTES=15
# TODO_SIGNUP_IP_LIMIT=5
# TODO_SIGNUP_IP_WINDOW_HOURS=1

# Full-chain PEM certificate for direct HTTPS in Gunicorn; set with the key below.
# TODO_SSL_CERTFILE=/path/to/fullchain.pem
# Private-key PEM paired with TODO_SSL_CERTFILE; both TLS paths are required.
# TODO_SSL_KEYFILE=/path/to/private-key.pem
# Mark cookies secure when the browser-facing connection uses HTTPS.
# TODO_SECURE_COOKIES=1

# SQLAlchemy database URL; defaults to the SQLite database in the instance directory.
# TODO_DATABASE=sqlite:////absolute/path/to/instance/todo.sqlite3
# Session and CSRF signing key; if unset, a key is generated in the instance directory.
# SECRET_KEY=
